# ---- Database ----
# Default: local SQLite, zero setup. Swap to a Postgres/Supabase URL later, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///finance_platform.db

# ---- LLM providers (free tiers) ----
# Get a free key at https://aistudio.google.com/
GOOGLE_AI_STUDIO_KEY=

# Get a free key at https://openrouter.ai/
OPENROUTER_API_KEY=

# Which provider to use by default: "gemini" | "openrouter" | "ollama"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Only needed if LLM_PROVIDER=ollama and you're running it locally
OLLAMA_BASE_URL=http://localhost:11434

# ---- Optional: paid market-data keys (leave blank to use free yfinance only) ----
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
FMP_KEY=
TIINGO_KEY=

# ---- Vector store ----
CHROMA_PERSIST_DIR=./chroma_store
